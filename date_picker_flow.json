{
  "version": "7.3",
  "screens": [
    {
      "id": "date_selection_screen",
      "title": "Select Date",
      "terminal": true,
      "data": {
        "min_date": { "type": "string", "__example__": "2026-08-17" },
        "max_date": { "type": "string", "__example__": "2026-09-15" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Select Booking Date"
          },
          {
            "type": "TextBody",
            "text": "Please choose a convenient date for your Darshan/Pooja booking."
          },
          {
            "type": "DatePicker",
            "name": "date",
            "label": "Choose Date",
            "required": true,
            "min-date": "${data.min_date}",
            "max-date": "${data.max_date}"
          },
          {
            "type": "Footer",
            "label": "Confirm Date",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "date": "${form.date}"
              }
            }
          }
        ]
      }
    }
  ]
}
